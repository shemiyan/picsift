# 复制为 .env 后填写。.env 已在 .gitignore 里，不会提交。
# 值在 Supabase 后台 Project Settings → API Keys 找。

# ---- worker（后台程序）用 ----
SUPABASE_URL=
# Secret key（旧版叫 service_role），权限最高，只能放在后台，绝不能给前端
SUPABASE_SERVICE_ROLE_KEY=
# 可选：同站两次请求最小间隔（秒）、近似重复判定的汉明距离
PICSIFT_REQUEST_INTERVAL=1.0
PICSIFT_DUP_DISTANCE=6
# 允许抓取的站点（逗号分隔，子域名也算），为空表示不限制。
# 前端公开部署、任何人都能提交任务时必须设置，否则 worker 所在机器会被当成跳板去抓内网或任意网站。
PICSIFT_ALLOWED_HOSTS=
